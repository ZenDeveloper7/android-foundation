<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this theme only styles the window behind it. -->
    <style name="Theme.Foundation" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.Foundation.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Foundation</item>
    </style>
</resources>
