<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup. This is an allowlist: only the files named here are backed up.
    Rules work on whole files; there is no per-key exclusion. Put data that must not be backed up
    (tokens, caches, device-specific state) in a separate file and leave it out of this list.
    Keep in sync with backup_rules.xml (Android 11 and lower).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="foundation.db" />
        <include domain="database" path="foundation.db-wal" />
        <include domain="file" path="datastore/user_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="foundation.db" />
        <include domain="database" path="foundation.db-wal" />
        <include domain="file" path="datastore/user_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
